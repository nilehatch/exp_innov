@unpublished{hatchCognitiveExposureHow2026,
  title = {Cognitive {{Exposure}}: {{How Rivals}}' {{Representations Shape Competitive Performance}}},
  author = {Hatch, Nile W. and Ostler, James},
  date = {2026},
  abstract = {Research on managerial cognition generally treats a firm's representation of its environment as a property of that firm: what managers attend to shapes what their firm does and how it performs. In competition, however, the value of a representation cannot be evaluated inside one firm's head. Drawing on the attention-based view, we cross attention to rivalry with attention to uncertainty to derive a lattice of cognitive representations that firms may hold when contemplating entry into a new and uncertain market, and we study every pairing of these representations in a dynamic entry model integrating game theory and real options. We find that the performance value of a representation is relational rather than  intrinsic: a firm's representation determines not only its own decisions but also its exposure to its rival's cognition. The rival's representation explains more of the variation in a firm's performance than the firm's own in most environments we simulate --- but this dominance is concentrated among rivalry- blind firms, and a representation combining rivalry awareness with flexibility largely insures its holder against the rival's mind. Decomposing a rival's sophistication reveals that its perceptive components help the focal firm while its commitment capability systematically hurts it, and identically matched representations underperform, producing a premium to cognitive differentiation between rivals. The long-established tradeoff between strategic commitment and strategic flexibility itself shifts with the representation held by one's rival. Attention, these results suggest, is competitively consequential not as an attribute of the attending firm but as a configuration across competing firms.},
  keywords = {innovation},
  file = {/Users/nilehatch/Zotero/storage/DMUP2FKF/Hatch and Ostler - 2026 - Cognitive Exposure How Rivals’ Representations Shape Competitive Performance.pdf}
}

