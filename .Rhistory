getwd()
s_int = 0.27
s_slope <- 0.0
f_s_quad_loss <- function(a,x) s_int + s_slope*x - (a-x)^2
f_s_lin_loss <- function(a,x) s_int + s_slope*x - abs(a-x)
ggplot() + xlim(0,6) +
stat_function(fun = dnorm, args = list(mean = 3, sd = 1), color = "royalblue3", size = 2) +
stat_function(fun = dnorm, args = list(mean = 3, sd = 1), geom = "area",
fill = "royalblue3", alpha = 0.25) +
#  geom_function(fun = f_s_quad_loss, args = (list(a = 3)), color = "skyblue3", size =1) +
#  geom_function(fun = f_s_lin_loss, args = (list(a = 3)), color = "skyblue3", size =1) +
geom_segment(aes(x = 3.5, y = 0, xend = 3.5, yend = .3), color = "springgreen4", size = 2) + # wtp
geom_segment(aes(x = 3.4, y = .3, xend = 3.6, yend = .3), color = "springgreen4", size = 2) + # wtp cross-hatch
geom_segment(aes(x = 3.5, y = .3, xend = 2.4, yend = 0), color = "springgreen4", size = 2) + # left loss function
geom_segment(aes(x = 3.5, y = .3, xend = 4.6, yend = 0), color = "springgreen4", size = 2) + # right loss function
geom_segment(aes(x = 0, y = 0, xend = 6, yend = 0), color = "black", size = 2) + # x-axis
#  annotate("text", x = 3.64, y = 0.025, label = "x", color = "Black", fontface = "italic", size = 9) +
annotate("text", x = 3.36, y = 0.324, label = "W", color = "Black", size = 9) +
annotate("text", x = 6, y = 0.2, label = "Willingness to Pay", color = "Black", fontface = "bold", size = 7, angle = 90) +
#  annotate("text", x = 3, y = -.029, label = "Customer Preferences", color = "Black", size = 5) +
#  scale_y_continuous(lim = c(-0.01,.5))
#  scale_x_continuous(lim = c(0, 6)) + #, labels = NULL, breaks = NULL) +
# labs(x = "Customer Preferences", y = "Number of Customers") +
xlab("Customer Preferences")+
ylab(NULL) +
annotate("text", x = 0, y = 0.2, label = "Number of Customers", color = "Black", fontface = "bold", size = 7, angle = 90) +
#  scale_x_continuous(lim = c(0,3), labels=scales::dollar_format()) +
scale_y_continuous(lim = c(-0.00,.4), labels=NULL) +
theme_hc() +
theme(axis.title = element_text(size = 20, face = "bold"), # bold both axis labels
axis.ticks.x = element_blank(), # delete ticks.x
axis.text.x = element_blank(),  # delete text.x
axis.ticks.y = element_blank(),
axis.text.y = element_blank()
)
library(tidyverse)
library(ggthemes)
library(scales)
library(gridExtra)
ggplot() + xlim(0,6) +
stat_function(fun = dnorm, args = list(mean = 3, sd = 1), color = "royalblue3", size = 2) +
stat_function(fun = dnorm, args = list(mean = 3, sd = 1), geom = "area",
fill = "royalblue3", alpha = 0.25) +
geom_abline(intercept = .0, slope = .0, color = "black", size = 2) + # customer wtp - WTP = 1 when x = mu
#  annotate("text", x = 3, y = -.029, label = "Customer Preferences", color = "Black", size = 5) +
# scale_y_continuous(lim = c(-0.01,.5))
# scale_y_continuous(lim = c(-0.01,.5), labels = NULL, breaks = NULL) +
#  scale_x_continuous(lim = c(0, 6)) + #,   labels = NULL, breaks = NULL) +
#labs(x = "Customer Preferences", y = "Number of Customers") +
xlab("Customer Preferences")+
ylab(NULL) +
annotate("text", x = 0, y = 0.2, label = "Number of Customers", color = "Black", fontface = "bold", size = 7, angle = 90) +
#  scale_x_continuous(lim = c(0,3), labels=scales::dollar_format()) +
#  scale_y_continuous(lim = c(4,20), labels=NULL) +
scale_y_continuous(lim = c(0,.4), labels=NULL) +
theme_hc() +
theme(axis.title = element_text(size = 20, face = "bold"), # bold both axis labels
axis.ticks.x = element_blank(), # delete ticks.x
axis.text.x = element_blank(),  # delete text.x
axis.ticks.y = element_blank(),
axis.text.y = element_blank()
)
