# create a function with available profits
#f_profit_fn <- function(x) {.3*dnorm(x,1.65,0.60) + .3*dnorm(x,4.3,0.60) } # original with Pi > 0 at center
f_profit_fn <- function(x) {.5*dnorm(x,1.1,1.00) + .5*dnorm(x,4.9,1.00) - 0.11 }
ggplot() + xlim(-0,6) +
geom_segment(aes(x = 3, y = 0, xend = 3, yend = .4), color = "black") + # firm 1 location
geom_segment(aes(x = 2.85, y = 0, xend = 2.85, yend = .392), color = "black") + # firm 2 location
geom_segment(aes(x = 3.1, y = 0, xend = 3.1, yend = .396), color = "black") + # firm 3 location
stat_function(fun = dnorm, args = list(mean = 3, sd = 1), color = "royalblue3", size = 2) +
stat_function(fun = dnorm, args = list(mean = 3, sd = 1), geom = "area",
fill = "royalblue3", alpha = 0.25) +
#
stat_function(fun = f_profit_fn, color = "darkgreen", size = 2) +
stat_function(fun = f_profit_fn, geom = "area", fill = "darkgreen", alpha = .3) +
#  geom_segment(aes(x = 4.3, y = 0, xend = 4.3, yend = .199), color = "black", size = 1.2) + # innovator location
#  geom_segment(aes(x = 1.7, y = 0, xend = 1.7, yend = .199), color = "black", size = 1.2) + # innovator location
#
geom_segment(aes(x = 0, y = 0, xend = 6, yend = 0), color = "black", size = 2) + # x-axis
annotate("text", x = 6, y = 0.22, label = "Available Profit", color = "Black", fontface = "bold", size = 6, angle = 90) +
#  scale_y_continuous(lim = c(-0.01,.5))
#  scale_x_continuous(lim = c(0, 6)) + #, labels = NULL, breaks = NULL) +
#labs(x = "Customer Preferences", y = "Number of Customers") +
xlab("Customer Preferences")+
ylab(NULL) +
annotate("text", x = -0, y = 0.22, label = "Number of Customers", color = "Black", fontface = "bold", size = 6, angle = 90) +
#  scale_x_continuous(lim = c(0,3), labels=scales::dollar_format()) +
#scale_y_continuous(lim = c(-0.00,.4), labels=NULL) +
scale_y_continuous(lim = c(-0.05,.4), labels=NULL) +
theme_hc() +
theme(axis.title = element_text(size = 20, face = "bold"), # bold both axis labels
axis.ticks.x = element_blank(), # delete ticks.x
axis.text.x = element_blank(),  # delete text.x
axis.ticks.y = element_blank(),
axis.text.y = element_blank()
